{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codemeta-drift check report",
  "description": "What `codemeta-drift <checkout> --json` writes. Contract: https://github.com/simonvanlierde/codemeta-drift/blob/main/docs/checks.md#read-json-output.",
  "type": "object",
  "required": ["schema_version", "tool", "findings", "errors"],
  "properties": {
    "schema_version": { "const": 1 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "codemeta-drift" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "file", "term", "detail"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "file": { "type": "string" },
          "term": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message", "help"],
        "properties": {
          "message": { "type": "string" },
          "help": { "type": ["string", "null"] }
        }
      }
    }
  }
}
